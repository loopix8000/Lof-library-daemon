{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lof Library",
  "version": "0.1.4",
  "identifier": "local.lof.library",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lof Library",
        "width": 920,
        "height": 780,
        "minWidth": 640,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQkYwNEUxOEQxMzdFNDcKUldSSGZoT040UVMvc2gwU0NoWEZic2VzTGxocEx2aVJ2OXFYckRlS2M0RmFQNW9sQVh1a1BxcWsK",
      "endpoints": [
        "https://github.com/loopix8000/Lof-library-daemon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Lof Writer",
    "shortDescription": "실시간 서재 동기화",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}

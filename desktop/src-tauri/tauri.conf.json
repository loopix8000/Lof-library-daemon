{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lof Library",
  "version": "0.1.0",
  "identifier": "local.lof.library",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lof Library 서버",
        "width": 920,
        "height": 780,
        "minWidth": 640,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lof Writer",
    "shortDescription": "Lof Writer 서재 동기화 서버",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "displayLanguageSelector": false
      }
    }
  }
}
